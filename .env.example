# CVE Explorer — deployment environment variables
# Copy to .env and adjust before running `docker compose up`.
# NEVER commit real secrets.
#
# Required variables (docker compose will fail without these):
#   POSTGRES_PASSWORD, REDIS_PASSWORD, API_KEYS, CORS_ORIGINS

# --- Database ---
POSTGRES_DB=cve_explorer
POSTGRES_USER=postgres
# REQUIRED: generate a strong password, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Redis ---
# REQUIRED: generate a strong password
REDIS_PASSWORD=

# --- Application ---
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# --- Frontend ---
# Public URL prefix if any (leave empty for same-origin).
VITE_API_URL=
# Host port that serves the app (nginx).
FRONTEND_PORT=80
# Must match one of API_KEYS below if you enable write auth.
# NOTE: This key is embedded in the JS bundle and visible to any visitor.
# It provides rate-limit-level protection only, NOT real security.
VITE_API_KEY=

# --- CORS (origins allowed to call the API cross-origin) ---
# REQUIRED: set to your domain, e.g. "https://cve.example.com"
CORS_ORIGINS=

# --- External intelligence ---
# NVD API key (free): https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows only ~5 requests / 30s and batch lookups will throttle.
NVD_API_KEY=
# Optional: raises GitHub exploit search from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- Write-endpoint auth (STRONGLY recommended if internet-facing) ---
# REQUIRED: anyone can write remediation records / mark alerts read without this.
# Comma-separated list; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOOKUP=20/minute

# --- Cache TTLs (seconds) ---
CACHE_TTL_CVE=86400
CACHE_TTL_EPSS=21600
CACHE_TTL_KEV=43200

# --- Backups ---
# Retention for scripts/backup_db.sh dumps.
RETENTION_DAYS=14
