# CVE Explorer — backend environment configuration
# Copy to backend/.env for local development, or set in your deployment runtime.
# NEVER commit real secrets.

# --- Runtime ---
APP_NAME=CVE Explorer
APP_ENV=development            # development | production
DEBUG=true                     # MUST be false in production
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default local): sqlite+aiosqlite:///./cve_explorer.db
# PostgreSQL (production): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./cve_explorer.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis (celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- External intelligence APIs ---
# NVD v2 API key (free at https://nvd.nist.gov/developers/request-an-api-key) —
# raises the rate limit from ~5 to ~50 requests / 30s. Strongly recommended.
NVD_API_KEY=
# GitHub token (optional) — raises exploit search from 60 to 5000 requests/hour.
GITHUB_TOKEN=
HTTP_TIMEOUT=30

# --- Upstream retry behaviour ---
# Retries on upstream throttling/5xx with Retry-After support + exponential backoff.
MAX_UPSTREAM_ATTEMPTS=3
UPSTREAM_RETRY_STATUSES=403,429,500,502,503,504

# --- API-key auth for write endpoints ---
# Empty = auth DISABLED (anyone can create/update remediation records and mark
# alerts read). Set a comma-separated list of secrets to require
# "X-API-Key: <key>" or "Authorization: Bearer <key>" on write endpoints.
# Reads (CVE lookup, batch, compare, analytics) always stay public.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- API rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOOKUP=20/minute

# --- Cache TTLs (seconds) ---
CACHE_TTL_CVE=86400
CACHE_TTL_EPSS=21600
CACHE_TTL_KEV=43200